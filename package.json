{
  "name": "tugas-testing-qa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run test:coverage && rm -rf dist/tests dist/coverage dist/e2e && mkdir -p dist/tests dist/e2e && cp -r html/* dist/tests/ && cp -r html/coverage dist/coverage && (cp -r public/e2e/* dist/e2e/ || true)",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:selenium": "node tests/selenium/login.e2e.cjs",
    "test:e2e": "mocha tests/selenium/full-suite.e2e.cjs --reporter mochawesome --reporter-options reportDir=public/e2e,reportFilename=index",
    "test:e2e:prod": "APP_URL=https://uts-pemrograman-web-2-dslh.vercel.app/ npm run test:e2e",
    "test:e2e:ui": "npm run test:e2e && open public/e2e/index.html"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.76.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "chai": "^6.2.2",
    "chromedriver": "^148.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "mocha": "^11.7.5",
    "mochawesome": "^7.1.4",
    "selenium-webdriver": "^4.44.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  }
}
